# Copy this file to `.env.local` (git-ignored) and fill in your own values.
# Vite only exposes variables prefixed with VITE_ to the browser bundle — everything here is PUBLIC.

# Supabase → Project Settings → API (or Data API) → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API Keys → the public "anon" key (legacy JWT) or the newer
# "publishable" key (sb_publishable_…). NEVER put the service_role / secret key here.
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional. URL sub-path the app is served from (build-time only, not exposed to the browser).
# Defaults to /nattandiya/ — set BASE_PATH=/ to serve from the domain root.
# BASE_PATH=/nattandiya/

# Optional. Cloudflare Turnstile site key. The report form currently renders a placeholder only —
# see DECISIONS.md (ADR-011) for how verification must be wired up server-side.
VITE_TURNSTILE_SITE_KEY=
