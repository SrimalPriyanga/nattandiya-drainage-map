{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/", "destination": "/nattandiya/", "permanent": false },
    { "source": "/nattandiya", "destination": "/nattandiya/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/nattandiya/((?!assets/).*)", "destination": "/nattandiya/index.html" }
  ],
  "headers": [
    {
      "source": "/nattandiya/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
